# AlphaDashboard environment variables
# Copy this file to `.env` and fill in the values.
# Every variable must be prefixed with VITE_ to be exposed to the client,
# and declared in src/env.ts so it is validated at startup.

# Base URL of the TestAPI backend, including the version segment.
# Feature code then uses clean paths such as api.get('/products').
VITE_API_URL=http://localhost:8000/api/v1
