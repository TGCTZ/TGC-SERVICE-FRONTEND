# TGC Service frontend environment variables
# Copy this file to `.env` and fill in the values.
# Every variable must be prefixed with VITE_ to be exposed to the client,
# and declared in src/env.ts so it is validated at startup.

# Base URL of the TGC API, including the version segment.
# Feature code then uses clean paths such as api.get('/orders').
VITE_API_URL=http://localhost:8000/api/v1

# Public origin a certificate's verification link points at.
# Leave blank to use wherever the app is served from. Set it only when the
# printed link must reach a different host, and keep the backend in step.
VITE_PUBLIC_BASE_URL=
